{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "resolveJsonModule": true,
        "strict": true,
        "rootDir": "./src",
        "outDir": "dist",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"]
}