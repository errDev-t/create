{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "resolveJsonModule": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"],
        // "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
    },
    "include": ["src"]
}